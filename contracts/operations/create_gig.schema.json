{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/create_gig.schema.json",
  "title": "create_gig",
  "description": "Wire contract for supported agent-tool operation create_gig. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1,
          "description": "Company offering the role."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Role title."
        },
        "externalJobId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "External job ID, or null."
        },
        "stage": {
          "type": "string",
          "enum": [
            "identified",
            "applied",
            "recruiter_contact",
            "screening",
            "technical_interview",
            "final_round",
            "offer",
            "monitoring",
            "closed"
          ],
          "description": "Pipeline stage."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "rejected",
            "withdrawn",
            "not_pursuing",
            "role_pulled",
            "no_response",
            "position_filled",
            "on_hold",
            "stale_or_unverified"
          ],
          "description": "Pipeline outcome."
        },
        "statusSummary": {
          "type": "string",
          "minLength": 1,
          "description": "Current status summary."
        },
        "lastActivity": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Most recent activity date."
        },
        "nextAction": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the candidate should do next."
                },
                "due": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Due date, or null."
                }
              },
              "required": [
                "description",
                "due"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Next action for the Gig, or null when no next action is planned."
        },
        "fit": {
          "type": "object",
          "properties": {
            "rating": {
              "type": "string",
              "enum": [
                "strong",
                "good",
                "stretch",
                "long_shot",
                "weak",
                "poor",
                "support",
                "tbd",
                "not_applicable"
              ],
              "description": "Candidate fit rating."
            },
            "summary": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fit explanation, or null."
            }
          },
          "required": [
            "rating",
            "summary"
          ],
          "additionalProperties": false,
          "description": "Assessment of how well the Gig fits the candidate."
        },
        "payRange": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "const": "USD",
                  "description": "Compensation currency."
                },
                "minimum": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Minimum compensation, or null."
                },
                "maximum": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Maximum compensation, or null."
                },
                "period": {
                  "type": "string",
                  "enum": [
                    "hour",
                    "year"
                  ],
                  "description": "Hourly or annual compensation."
                },
                "notes": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Compensation notes, or null."
                }
              },
              "required": [
                "currency",
                "minimum",
                "maximum",
                "period",
                "notes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Expected compensation range, or null when it is not known."
        },
        "sourceUrl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical source URL, or null when it is not known."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Replacement tag list."
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Location, or null."
        },
        "workArrangement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Work arrangement, or null."
        },
        "postedDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Posted date, or null."
        },
        "businessUnitTeam": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Business unit or team, or null."
        },
        "recruiterSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Recruiter source, or null."
        },
        "bonus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bonus details, or null."
        },
        "equity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Equity details, or null."
        },
        "otherCompensation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Other compensation, or null."
        }
      },
      "required": [
        "company",
        "title",
        "externalJobId",
        "stage",
        "outcome",
        "statusSummary",
        "lastActivity",
        "nextAction",
        "fit",
        "payRange",
        "sourceUrl",
        "tags",
        "location",
        "workArrangement",
        "postedDate",
        "businessUnitTeam",
        "recruiterSource",
        "bonus",
        "equity",
        "otherCompensation"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "record", "changeId"],
          "properties": {
            "status": {
              "const": "ok"
            },
            "record": { "type": "object" },
            "changeId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
