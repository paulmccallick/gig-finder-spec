{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/get_person.schema.json",
 "title": "get_person",
 "description": "Wire contract for supported agent-tool operation get_person. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1,
     "description": "Exact durable record ID returned by the corresponding list tool."
    }
   },
   "required": [
    "id"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "record"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "record": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "name",
        "company",
        "title",
        "linkedInProfileUrl",
        "profileStatus",
        "connectedOn",
        "relationship",
        "priority",
        "status",
        "lastContacted",
        "lastContactMethod",
        "lastContactSummary",
        "whyInteresting",
        "notes",
        "tags",
        "createdAt",
        "updatedAt",
        "hasProfile",
        "documents",
        "interactions",
        "gigs"
       ],
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "name": {
         "type": "string",
         "minLength": 1
        },
        "company": {
         "type": [
          "string",
          "null"
         ]
        },
        "title": {
         "type": [
          "string",
          "null"
         ]
        },
        "linkedInProfileUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "profileStatus": {
         "type": "string",
         "enum": [
          "missing",
          "verified"
         ]
        },
        "connectedOn": {
         "anyOf": [
          {
           "type": "string",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
           "type": "null"
          }
         ]
        },
        "relationship": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "type",
          "strength",
          "introducedBy",
          "notes"
         ],
         "properties": {
          "type": {
           "type": "string",
           "minLength": 1
          },
          "strength": {
           "type": "string",
           "enum": [
            "strong",
            "warm",
            "limited",
            "unknown"
           ]
          },
          "introducedBy": {
           "type": [
            "string",
            "null"
           ]
          },
          "notes": {
           "type": [
            "string",
            "null"
           ]
          }
         }
        },
        "priority": {
         "type": "string",
         "enum": [
          "high",
          "medium",
          "low",
          "unranked"
         ]
        },
        "status": {
         "type": "string",
         "enum": [
          "not_contacted",
          "outreach_planned",
          "outreach_sent",
          "awaiting_response",
          "conversation_scheduled",
          "active_relationship",
          "follow_up_due",
          "paused",
          "do_not_contact"
         ]
        },
        "lastContacted": {
         "anyOf": [
          {
           "type": "string",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
           "type": "null"
          }
         ]
        },
        "lastContactMethod": {
         "type": [
          "string",
          "null"
         ]
        },
        "lastContactSummary": {
         "type": [
          "string",
          "null"
         ]
        },
        "whyInteresting": {
         "type": [
          "string",
          "null"
         ]
        },
        "notes": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "tags": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "createdAt": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "updatedAt": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "hasProfile": {
         "type": "boolean"
        },
        "documents": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "id",
           "type",
           "title",
           "displayName",
           "currentVersion"
          ],
          "properties": {
           "id": {
            "type": "string",
            "minLength": 1
           },
           "type": {
            "type": "string",
            "enum": [
             "job_description",
             "notes",
             "interview_prep",
             "profile"
            ]
           },
           "title": {
            "type": [
             "string",
             "null"
            ]
           },
           "displayName": {
            "type": "string",
            "minLength": 1
           },
           "currentVersion": {
            "type": "integer",
            "minimum": 1
           }
          }
         }
        },
        "interactions": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "id",
           "subject",
           "kind",
           "channel",
           "status",
           "startsAt"
          ],
          "properties": {
           "id": {
            "type": "string",
            "minLength": 1
           },
           "subject": {
            "type": "string",
            "minLength": 1
           },
           "kind": {
            "type": "string",
            "enum": [
             "message",
             "call",
             "meeting",
             "interview",
             "conversation",
             "other"
            ]
           },
           "channel": {
            "type": "string",
            "enum": [
             "email",
             "linkedin",
             "sms",
             "chat",
             "phone",
             "video",
             "in_person",
             "other"
            ]
           },
           "status": {
            "type": "string",
            "enum": [
             "planned",
             "confirmed",
             "completed",
             "canceled",
             "no_show"
            ]
           },
           "startsAt": {
            "type": "string",
            "format": "date-time"
           }
          }
         }
        },
        "gigs": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "gigId",
           "relationship"
          ],
          "properties": {
           "gigId": {
            "type": "string",
            "minLength": 1
           },
           "relationship": {
            "type": "string",
            "enum": [
             "interviewer",
             "hiring_manager",
             "recruiter",
             "recruiting_coordinator",
             "employee",
             "former_peer",
             "professional_contact",
             "personal_contact"
            ]
           }
          }
         }
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id"
     ],
     "properties": {
      "status": {
       "const": "not_found"
      },
      "id": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "consistency_error"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
