{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/update_document.schema.json",
 "title": "update_document",
 "description": "Wire contract for supported agent-tool operation update_document. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "documentId": {
     "type": "string",
     "minLength": 1,
     "description": "Exact managed-document ID returned by create_document, get_gig, get_person, or get_document."
    },
    "expectedVersion": {
     "type": "integer",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "description": "Current managed-document version returned by create_document, get_gig, or get_document."
    },
    "content": {
     "type": "string",
     "minLength": 1,
     "maxLength": 50000,
     "description": "Complete replacement content, up to 50000 characters."
    },
    "changeSummary": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500,
     "description": "Concise factual description of what changed."
    }
   },
   "required": [
    "documentId",
    "expectedVersion",
    "content",
    "changeSummary"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "changed",
      "changeId",
      "document"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "changed": {
       "type": "boolean"
      },
      "changeId": {
       "type": [
        "string",
        "null"
       ]
      },
      "document": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "links",
        "documentType",
        "title",
        "description",
        "mediaType",
        "sourceDescription",
        "filePath",
        "uploadProvenance",
        "displayName",
        "currentVersion",
        "contentHash",
        "createdAt",
        "updatedAt"
       ],
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "links": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "entityType",
           "entityId"
          ],
          "properties": {
           "entityType": {
            "type": "string",
            "enum": [
             "gig",
             "person",
             "profile"
            ]
           },
           "entityId": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        },
        "documentType": {
         "type": "string",
         "enum": [
          "job_description",
          "notes",
          "interview_prep",
          "profile"
         ]
        },
        "title": {
         "type": [
          "string",
          "null"
         ]
        },
        "description": {
         "type": [
          "string",
          "null"
         ]
        },
        "mediaType": {
         "type": "string",
         "enum": [
          "text/plain",
          "text/markdown"
         ]
        },
        "sourceDescription": {
         "type": [
          "string",
          "null"
         ]
        },
        "filePath": {
         "type": [
          "string",
          "null"
         ]
        },
        "uploadProvenance": {
         "anyOf": [
          {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "originalFilename",
            "detectedMediaType",
            "sourceContentHash",
            "converter",
            "converterVersion",
            "extractionWarnings",
            "uploadedAt"
           ],
           "properties": {
            "originalFilename": {
             "type": "string",
             "minLength": 1
            },
            "detectedMediaType": {
             "type": "string",
             "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "text/markdown"
             ]
            },
            "sourceContentHash": {
             "type": "string",
             "pattern": "^[0-9a-f]{64}$"
            },
            "converter": {
             "type": "string",
             "minLength": 1
            },
            "converterVersion": {
             "type": "string",
             "minLength": 1
            },
            "extractionWarnings": {
             "type": "array",
             "items": {
              "type": "string"
             }
            },
            "uploadedAt": {
             "type": "string",
             "format": "date-time"
            }
           }
          },
          {
           "type": "null"
          }
         ]
        },
        "displayName": {
         "type": "string",
         "minLength": 1
        },
        "currentVersion": {
         "type": "integer",
         "minimum": 1
        },
        "contentHash": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "createdAt": {
         "type": "string",
         "format": "date-time"
        },
        "updatedAt": {
         "type": "string",
         "format": "date-time"
        }
       }
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "changed": {
          "const": true
         }
        },
        "required": [
         "changed"
        ]
       },
       "then": {
        "properties": {
         "changeId": {
          "type": "string",
          "minLength": 1
         }
        }
       },
       "else": {
        "properties": {
         "changeId": {
          "const": null
         }
        }
       }
      }
     ]
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
