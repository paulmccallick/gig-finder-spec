{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/update_document.schema.json",
  "title": "update_document",
  "description": "Wire contract for supported agent-tool operation update_document. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "description": "Exact managed-document ID returned by create_document, get_gig, get_person, or get_document."
        },
        "expectedVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Current managed-document version returned by create_document, get_gig, or get_document."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "description": "Complete replacement content, up to 50000 characters."
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise factual description of what changed."
        }
      },
      "required": [
        "documentId",
        "expectedVersion",
        "content",
        "changeSummary"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "changeId"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "changeId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
