{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/list_gigs.schema.json",
  "title": "list_gigs",
  "description": "Wire contract for supported agent-tool operation list_gigs. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "stages": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "identified",
                  "applied",
                  "recruiter_contact",
                  "screening",
                  "technical_interview",
                  "final_round",
                  "offer",
                  "monitoring",
                  "closed"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Include gigs in any of these pipeline stages."
        },
        "outcomes": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pending",
                  "accepted",
                  "rejected",
                  "withdrawn",
                  "not_pursuing",
                  "role_pulled",
                  "no_response",
                  "position_filled",
                  "on_hold",
                  "stale_or_unverified"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Include gigs with any of these outcomes."
        },
        "fitRatings": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "strong",
                  "good",
                  "stretch",
                  "long_shot",
                  "weak",
                  "poor",
                  "support",
                  "tbd",
                  "not_applicable"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Include gigs with any of these candidate fit ratings."
        },
        "overdueOnly": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "When true, include only gigs whose next action is overdue."
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Case-insensitive text to search across gig company, title, status summary, and next action."
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Zero-based number of matching records to skip. Uses 0 when not specified."
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum number of records to return, from 1 to 50. Uses 20 when not specified."
        }
      },
      "required": [
        "stages",
        "outcomes",
        "fitRatings",
        "overdueOnly",
        "query",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items",
            "page"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "page": {
              "type": "object",
              "required": [
                "offset",
                "limit",
                "total",
                "nextOffset"
              ],
              "properties": {
                "offset": {
                  "type": "integer"
                },
                "limit": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                },
                "nextOffset": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
