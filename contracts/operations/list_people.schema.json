{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/list_people.schema.json",
 "title": "list_people",
 "description": "Wire contract for supported agent-tool operation list_people. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "statuses": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "not_contacted",
         "outreach_planned",
         "outreach_sent",
         "awaiting_response",
         "conversation_scheduled",
         "active_relationship",
         "follow_up_due",
         "paused",
         "do_not_contact"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include people with any of these relationship statuses."
    },
    "priorities": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "high",
         "medium",
         "low",
         "unranked"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include people with any of these relationship priorities."
    },
    "relationshipStrengths": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "strong",
         "warm",
         "limited",
         "unknown"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include people with any of these relationship strengths."
    },
    "query": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Case-insensitive text to search across person name, company, title, and why-interesting text."
    },
    "offset": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ],
     "description": "Zero-based number of matching records to skip. Uses 0 when not specified."
    },
    "limit": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      },
      {
       "type": "null"
      }
     ],
     "description": "Maximum number of records to return, from 1 to 50. Uses 20 when not specified."
    }
   },
   "required": [
    "statuses",
    "priorities",
    "relationshipStrengths",
    "query",
    "offset",
    "limit"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "items",
      "page"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id",
         "name",
         "company",
         "title",
         "linkedInProfileUrl",
         "profileStatus",
         "connectedOn",
         "relationship",
         "priority",
         "status",
         "lastContacted",
         "lastContactMethod",
         "lastContactSummary",
         "whyInteresting",
         "notes",
         "tags",
         "createdAt",
         "updatedAt",
         "hasProfile",
         "documents",
         "interactions"
        ],
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "name": {
          "type": "string",
          "minLength": 1
         },
         "company": {
          "type": [
           "string",
           "null"
          ]
         },
         "title": {
          "type": [
           "string",
           "null"
          ]
         },
         "linkedInProfileUrl": {
          "type": [
           "string",
           "null"
          ]
         },
         "profileStatus": {
          "type": "string",
          "enum": [
           "missing",
           "verified"
          ]
         },
         "connectedOn": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           {
            "type": "null"
           }
          ]
         },
         "relationship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "type",
           "strength",
           "introducedBy",
           "notes"
          ],
          "properties": {
           "type": {
            "type": "string",
            "minLength": 1
           },
           "strength": {
            "type": "string",
            "enum": [
             "strong",
             "warm",
             "limited",
             "unknown"
            ]
           },
           "introducedBy": {
            "type": [
             "string",
             "null"
            ]
           },
           "notes": {
            "type": [
             "string",
             "null"
            ]
           }
          }
         },
         "priority": {
          "type": "string",
          "enum": [
           "high",
           "medium",
           "low",
           "unranked"
          ]
         },
         "status": {
          "type": "string",
          "enum": [
           "not_contacted",
           "outreach_planned",
           "outreach_sent",
           "awaiting_response",
           "conversation_scheduled",
           "active_relationship",
           "follow_up_due",
           "paused",
           "do_not_contact"
          ]
         },
         "lastContacted": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           {
            "type": "null"
           }
          ]
         },
         "lastContactMethod": {
          "type": [
           "string",
           "null"
          ]
         },
         "lastContactSummary": {
          "type": [
           "string",
           "null"
          ]
         },
         "whyInteresting": {
          "type": [
           "string",
           "null"
          ]
         },
         "notes": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "tags": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "hasProfile": {
          "type": "boolean"
         },
         "documents": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "id",
            "type",
            "title",
            "displayName",
            "currentVersion"
           ],
           "properties": {
            "id": {
             "type": "string",
             "minLength": 1
            },
            "type": {
             "type": "string",
             "enum": [
              "job_description",
              "notes",
              "interview_prep",
              "profile"
             ]
            },
            "title": {
             "type": [
              "string",
              "null"
             ]
            },
            "displayName": {
             "type": "string",
             "minLength": 1
            },
            "currentVersion": {
             "type": "integer",
             "minimum": 1
            }
           }
          }
         },
         "interactions": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "id",
            "subject",
            "kind",
            "channel",
            "status",
            "startsAt"
           ],
           "properties": {
            "id": {
             "type": "string",
             "minLength": 1
            },
            "subject": {
             "type": "string",
             "minLength": 1
            },
            "kind": {
             "type": "string",
             "enum": [
              "message",
              "call",
              "meeting",
              "interview",
              "conversation",
              "other"
             ]
            },
            "channel": {
             "type": "string",
             "enum": [
              "email",
              "linkedin",
              "sms",
              "chat",
              "phone",
              "video",
              "in_person",
              "other"
             ]
            },
            "status": {
             "type": "string",
             "enum": [
              "planned",
              "confirmed",
              "completed",
              "canceled",
              "no_show"
             ]
            },
            "startsAt": {
             "type": "string",
             "format": "date-time"
            }
           }
          }
         }
        }
       }
      },
      "page": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "offset",
        "limit",
        "returned",
        "total",
        "hasMore",
        "nextOffset"
       ],
       "properties": {
        "offset": {
         "type": "integer"
        },
        "limit": {
         "type": "integer"
        },
        "returned": {
         "type": "integer"
        },
        "total": {
         "type": "integer"
        },
        "hasMore": {
         "type": "boolean"
        },
        "nextOffset": {
         "type": [
          "integer",
          "null"
         ]
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "consistency_error"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
