              "type": "string",
              "minLength": 1
             },
             "retrievedAt": {
              "type": "string",
              "format": "date-time"
             },
             "sourceContentHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
             },
             "extractedContentHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
