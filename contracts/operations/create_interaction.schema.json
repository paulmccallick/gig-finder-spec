{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/create_interaction.schema.json",
  "title": "create_interaction",
  "description": "Wire contract for supported agent-tool operation create_interaction. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "Interaction subject."
        },
        "kind": {
          "type": "string",
          "enum": [
            "message",
            "call",
            "meeting",
            "interview",
            "conversation",
            "other"
          ],
          "description": "Semantic interaction kind."
        },
        "channel": {
          "type": "string",
          "enum": [
            "email",
            "linkedin",
            "sms",
            "chat",
            "phone",
            "video",
            "in_person",
            "other"
          ],
          "description": "Interaction delivery channel."
        },
        "direction": {
          "type": "string",
          "enum": [
            "inbound",
            "outbound",
            "mutual",
            "unknown"
          ],
          "description": "Direction relative to the candidate."
        },
        "startsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "Interaction start as an ISO 8601 timestamp with an offset."
        },
        "endsAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ],
          "description": "End timestamp, or null for a point-in-time interaction."
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "IANA timezone, or null."
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "confirmed",
            "completed",
            "canceled",
            "no_show"
          ],
          "description": "Interaction lifecycle status."
        },
        "personIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "One or more unique, exact durable Person IDs returned by a person or contact tool."
        },
        "gigId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact durable Gig ID returned by a gig tool, or null when the interaction is not gig-specific."
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Interaction location, or null when unknown."
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Concise interaction summary, or null."
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Longer notes, or null."
        },
        "supersedesInteractionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Prior corrected interaction ID, or null."
        }
      },
      "required": [
        "subject",
        "kind",
        "channel",
        "direction",
        "startsAt",
        "endsAt",
        "timezone",
        "status",
        "personIds",
        "gigId",
        "location",
        "summary",
        "notes",
        "supersedesInteractionId"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "changeId"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "changeId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
