{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/search_gigs_and_people.schema.json",
 "title": "search_gigs_and_people",
 "description": "Wire contract for supported agent-tool operation search_gigs_and_people. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "companyNames": {
     "maxItems": 4,
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
     },
     "description": "Company names to match against gigs and people; use an empty array when none are known."
    },
    "personNames": {
     "maxItems": 4,
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
     },
     "description": "Person names to match against people; use an empty array when none are known."
    }
   },
   "required": [
    "companyNames",
    "personNames"
   ],
   "additionalProperties": false
  },
  "result": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "gigs",
    "people",
    "truncated"
   ],
   "properties": {
    "gigs": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "company",
       "title",
       "stage",
       "outcome",
       "matchedCompanyNames"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "company": {
        "type": "string",
        "minLength": 1
       },
       "title": {
        "type": "string",
        "minLength": 1
       },
       "stage": {
        "type": "string",
        "enum": [
         "identified",
         "applied",
         "recruiter_contact",
         "screening",
         "technical_interview",
         "final_round",
         "offer",
         "monitoring",
         "closed"
        ]
       },
       "outcome": {
        "type": "string",
        "enum": [
         "pending",
         "accepted",
         "rejected",
         "withdrawn",
         "not_pursuing",
         "role_pulled",
         "no_response",
         "position_filled",
         "on_hold",
         "stale_or_unverified"
        ]
       },
       "matchedCompanyNames": {
        "type": "array",
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 2,
         "maxLength": 200
        }
       }
      }
     }
    },
    "people": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "name",
       "company",
       "title",
       "status",
       "matchedCompanyNames",
       "matchedPersonNames"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "name": {
        "type": "string",
        "minLength": 1
       },
       "company": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "type": "string",
        "enum": [
         "not_contacted",
         "outreach_planned",
         "outreach_sent",
         "awaiting_response",
         "conversation_scheduled",
         "active_relationship",
         "follow_up_due",
         "paused",
         "do_not_contact"
        ]
       },
       "matchedCompanyNames": {
        "type": "array",
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 2,
         "maxLength": 200
        }
       },
       "matchedPersonNames": {
        "type": "array",
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 2,
         "maxLength": 200
        }
       }
      }
     }
    },
    "truncated": {
     "type": "boolean"
    }
   }
  }
 }
}
