{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/list_documents.schema.json",
 "title": "list_documents",
 "description": "Wire contract for supported agent-tool operation list_documents. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "owner": {
     "type": "object",
     "properties": {
      "entityType": {
       "type": "string",
       "enum": [
        "gig",
        "person",
        "profile"
       ]
      },
      "entityId": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      }
     },
     "required": [
      "entityType",
      "entityId"
     ],
     "additionalProperties": false,
     "description": "Exactly one Gig, Person, or candidate Profile owner."
    },
    "offset": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ],
     "description": "Zero-based number of matching records to skip. Uses 0 when not specified."
    },
    "limit": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      },
      {
       "type": "null"
      }
     ],
     "description": "Maximum number of records to return, from 1 to 50. Uses 20 when not specified."
    }
   },
   "required": [
    "owner",
    "offset",
    "limit"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "items",
      "page"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "reference",
         "entityType",
         "entityId",
         "documentType",
         "title",
         "displayName",
         "storage",
         "currentVersion"
        ],
        "properties": {
         "reference": {
          "type": "string",
          "minLength": 1
         },
         "entityType": {
          "type": "string",
          "enum": [
           "gig",
           "person",
           "profile"
          ]
         },
         "entityId": {
          "type": "string",
          "minLength": 1
         },
         "documentType": {
          "type": "string",
          "enum": [
           "job_description",
           "notes",
           "interview_prep",
           "profile"
          ]
         },
         "title": {
          "type": [
           "string",
           "null"
          ]
         },
         "displayName": {
          "type": "string",
          "minLength": 1
         },
         "storage": {
          "const": "managed"
         },
         "currentVersion": {
          "type": "integer",
          "minimum": 1
         }
        }
       }
      },
      "page": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "offset",
        "limit",
        "returned",
        "total",
        "hasMore",
        "nextOffset"
       ],
       "properties": {
        "offset": {
         "type": "integer"
        },
        "limit": {
         "type": "integer"
        },
        "returned": {
         "type": "integer"
        },
        "total": {
         "type": "integer"
        },
        "hasMore": {
         "type": "boolean"
        },
        "nextOffset": {
         "type": [
          "integer",
          "null"
         ]
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id"
     ],
     "properties": {
      "status": {
       "const": "not_found"
      },
      "id": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "unsupported"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "consistency_error"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
