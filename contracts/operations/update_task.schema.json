{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/update_task.schema.json",
  "title": "update_task",
  "description": "Wire contract for supported agent-tool operation update_task. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Exact durable record ID returned by the corresponding list tool."
        },
        "changes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "set",
                  "clear"
                ],
                "description": "Use set to assign a value or clear to remove a nullable value."
              },
              "field": {
                "type": "string",
                "enum": [
                  "title",
                  "type",
                  "status",
                  "priority",
                  "dueDate",
                  "relatedEntity",
                  "notes"
                ],
                "description": "Exact mutable domain field path; nested fields use dot notation."
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "description": "Concise task title."
                  },
                  {
                    "type": "string",
                    "enum": [
                      "networking_follow_up",
                      "application",
                      "interview_prep",
                      "sourcing",
                      "resume",
                      "administrative",
                      "learning",
                      "other"
                    ],
                    "description": "Task category type."
                  },
                  {
                    "type": "string",
                    "enum": [
                      "open",
                      "in_progress",
                      "completed",
                      "canceled"
                    ],
                    "description": "Task status."
                  },
                  {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ],
                    "description": "Task priority."
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Due date, or null."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "gig",
                          "person",
                          "general"
                        ],
                        "description": "Related entity type."
                      },
                      "id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Exact Gig or Person ID, or null for general."
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ],
                    "additionalProperties": false,
                    "description": "Gig, Person, or general relationship."
                  },
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Notes, or null."
                  }
                ],
                "description": "Value validated by the selected entity-owned domain field schema."
              }
            },
            "required": [
              "operation",
              "field",
              "value"
            ],
            "additionalProperties": false
          },
          "description": "One or more explicit changes to mutable task fields."
        }
      },
      "required": [
        "id",
        "changes"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "changeId"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "changeId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
