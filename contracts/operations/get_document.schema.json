{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/get_document.schema.json",
  "title": "get_document",
  "description": "Wire contract for supported agent-tool operation get_document. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Exact registered reference returned by a detail tool or staged reference supplied by the web application."
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Specific managed-document version to retrieve, or null for the current version or a non-versioned reference."
        }
      },
      "required": [
        "reference",
        "version"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "record"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "record": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "id"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_found",
                "unsupported",
                "consistency_error"
              ]
            },
            "id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
