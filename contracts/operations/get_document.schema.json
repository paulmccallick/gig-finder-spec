{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/get_document.schema.json",
 "title": "get_document",
 "description": "Wire contract for supported agent-tool operation get_document. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "reference": {
     "type": "string",
     "minLength": 1,
     "description": "Exact registered reference returned by a detail tool or staged reference supplied by the web application."
    },
    "version": {
     "anyOf": [
      {
       "type": "integer",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ],
     "description": "Specific managed-document version to retrieve, or null for the current version or a non-versioned reference."
    }
   },
   "required": [
    "reference",
    "version"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "record"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "record": {
       "oneOf": [
        {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "reference",
          "entityType",
          "entityId",
          "documentType",
          "title",
          "displayName",
          "storage",
          "currentVersion",
          "mediaType",
          "version",
          "content",
          "truncated",
          "totalCharacters"
         ],
         "properties": {
          "reference": {
           "type": "string",
           "minLength": 1
          },
          "entityType": {
           "type": "string",
           "enum": [
            "gig",
            "person",
            "profile"
           ]
          },
          "entityId": {
           "type": "string",
           "minLength": 1
          },
          "documentType": {
           "type": "string",
           "enum": [
            "job_description",
            "notes",
            "interview_prep",
            "profile"
           ]
          },
          "title": {
           "type": [
            "string",
            "null"
           ]
          },
          "displayName": {
           "type": "string",
           "minLength": 1
          },
          "storage": {
           "const": "managed"
          },
          "currentVersion": {
           "type": "integer",
           "minimum": 1
          },
          "mediaType": {
           "type": "string",
           "enum": [
            "text/plain",
            "text/markdown"
           ]
          },
          "version": {
           "type": "integer",
           "minimum": 1
          },
          "content": {
           "type": "string"
          },
          "truncated": {
           "type": "boolean"
          },
          "totalCharacters": {
           "type": "integer"
          }
         }
        },
        {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "reference",
          "storage",
          "mediaType",
          "content",
          "truncated",
          "totalCharacters",
          "provenance",
          "expiresAt"
         ],
         "properties": {
          "reference": {
           "type": "string",
           "minLength": 1
          },
          "storage": {
           "const": "staged"
          },
          "mediaType": {
           "const": "text/markdown"
          },
          "content": {
           "type": "string"
          },
          "truncated": {
           "const": false
          },
          "totalCharacters": {
           "type": "integer"
          },
          "provenance": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "originalFilename",
            "detectedMediaType",
            "sourceContentHash",
            "converter",
            "converterVersion",
            "extractionWarnings",
            "uploadedAt"
           ],
           "properties": {
            "originalFilename": {
             "type": "string",
             "minLength": 1
            },
            "detectedMediaType": {
             "type": "string",
             "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "text/markdown"
             ]
            },
            "sourceContentHash": {
             "type": "string",
             "pattern": "^[0-9a-f]{64}$"
            },
            "converter": {
             "type": "string",
             "minLength": 1
            },
            "converterVersion": {
             "type": "string",
             "minLength": 1
            },
            "extractionWarnings": {
             "type": "array",
             "items": {
              "type": "string"
             }
            },
            "uploadedAt": {
             "type": "string",
             "format": "date-time"
            }
           }
          },
          "expiresAt": {
           "type": "string",
           "format": "date-time"
          }
         }
        }
       ]
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id"
     ],
     "properties": {
      "status": {
       "const": "not_found"
      },
      "id": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "unsupported"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "consistency_error"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
