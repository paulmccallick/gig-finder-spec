{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/update_gig.schema.json",
 "title": "update_gig",
 "description": "Wire contract for supported agent-tool operation update_gig. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
