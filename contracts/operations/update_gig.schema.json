         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Recruiter source, or null."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Bonus details, or null."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Equity details, or null."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Other compensation, or null."
         }
        ],
        "description": "Value validated by the selected entity-owned domain field schema."
       }
      },
      "required": [
       "operation",
       "field",
       "value"
      ],
      "additionalProperties": false
     },
     "description": "One or more explicit changes to mutable gig fields."
