         "properties": {
          "rating": {
           "type": "string",
           "enum": [
            "strong",
            "good",
            "stretch",
            "long_shot",
            "weak",
            "poor",
            "support",
            "tbd",
            "not_applicable"
           ]
          },
          "summary": {
           "type": [
            "string",
            "null"
           ]
          }
         }
        },
        "payRange": {
         "anyOf": [
          {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "currency",
            "minimum",
            "maximum",
            "period",
            "notes"
           ],
           "properties": {
            "currency": {
             "const": "USD"
            },
            "minimum": {
             "type": [
              "number",
              "null"
             ]
            },
            "maximum": {
             "type": [
              "number",
              "null"
             ]
            },
            "period": {
             "type": "string",
             "enum": [
              "hour",
              "year"
             ]
            },
            "notes": {
             "type": [
              "string",
              "null"
             ]
            }
           }
          },
          {
           "type": "null"
          }
         ]
        },
        "sourceUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "tags": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "availability": {
         "type": "string",
         "enum": [
          "unknown",
          "available",
          "unavailable"
         ]
        },
        "availabilityUpdatedAt": {
         "anyOf": [
          {
           "type": "string",
           "format": "date-time"
          },
          {
           "type": "null"
          }
