        "description": "Use set to assign a value or clear to remove a nullable value."
       },
       "field": {
        "type": "string",
        "enum": [
         "company",
         "title",
         "externalJobId",
         "stage",
         "outcome",
         "statusSummary",
         "lastActivity",
         "nextAction",
         "nextAction.description",
         "nextAction.due",
         "fit.rating",
         "fit.summary",
         "payRange",
         "payRange.currency",
         "payRange.minimum",
         "payRange.maximum",
         "payRange.period",
         "payRange.notes",
         "sourceUrl",
         "tags",
         "location",
         "workArrangement",
         "postedDate",
         "businessUnitTeam",
         "recruiterSource",
         "bonus",
         "equity",
         "otherCompensation"
        ],
        "description": "Exact mutable domain field path; nested fields use dot notation."
       },
       "value": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1,
          "description": "Company offering the role."
         },
         {
          "type": "string",
          "minLength": 1,
          "description": "Role title."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "External job ID, or null."
         },
         {
          "type": "string",
          "enum": [
           "identified",
           "applied",
           "recruiter_contact",
           "screening",
           "technical_interview",
           "final_round",
           "offer",
           "monitoring",
           "closed"
          ],
          "description": "Pipeline stage."
         },
         {
          "type": "string",
          "enum": [
           "pending",
           "accepted",
           "rejected",
           "withdrawn",
           "not_pursuing",
           "role_pulled",
           "no_response",
           "position_filled",
           "on_hold",
           "stale_or_unverified"
          ],
          "description": "Pipeline outcome."
         },
         {
          "type": "string",
          "minLength": 1,
          "description": "Current status summary."
         },
         {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Most recent activity date."
         },
         {
          "type": "string",
          "minLength": 1,
          "description": "What the candidate should do next."
         },
         {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           {
            "type": "null"
           }
          ],
          "description": "Due date, or null."
         },
         {
          "type": "string",
          "enum": [
           "strong",
           "good",
           "stretch",
           "long_shot",
           "weak",
           "poor",
           "support",
           "tbd",
           "not_applicable"
          ],
          "description": "Candidate fit rating."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Fit explanation, or null."
         },
         {
          "type": "string",
          "const": "USD",
          "description": "Compensation currency."
         },
         {
          "anyOf": [
           {
            "type": "number",
            "minimum": 0
           },
           {
            "type": "null"
           }
          ],
          "description": "Minimum compensation, or null."
         },
         {
          "anyOf": [
           {
            "type": "number",
            "minimum": 0
           },
           {
            "type": "null"
           }
          ],
          "description": "Maximum compensation, or null."
         },
         {
          "type": "string",
          "enum": [
           "hour",
           "year"
          ],
          "description": "Hourly or annual compensation."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Compensation notes, or null."
         },
         {
          "anyOf": [
           {
            "type": "string",
            "minLength": 1
           },
           {
            "type": "null"
           }
          ],
          "description": "Canonical source URL, or null."
         },
         {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          },
          "description": "Replacement tag list."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Location, or null."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Work arrangement, or null."
         },
         {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           {
            "type": "null"
           }
          ],
          "description": "Posted date, or null."
         },
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Business unit or team, or null."
