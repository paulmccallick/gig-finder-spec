        "lastActivity",
        "nextAction",
        "fit",
        "payRange",
        "sourceUrl",
        "tags",
        "availability",
        "availabilityUpdatedAt",
        "location",
        "workArrangement",
        "postedDate",
        "businessUnitTeam",
        "recruiterSource",
        "bonus",
        "equity",
        "otherCompensation",
        "documents",
        "interactions"
