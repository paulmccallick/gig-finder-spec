{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/list_interactions.schema.json",
 "title": "list_interactions",
 "description": "Wire contract for supported agent-tool operation list_interactions. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "personIds": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions involving any of these exact durable person IDs."
    },
    "gigIds": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions associated with any of these exact durable gig IDs."
    },
    "kinds": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "message",
         "call",
         "meeting",
         "interview",
         "conversation",
         "other"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions with any of these semantic kinds."
    },
    "channels": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "email",
         "linkedin",
         "sms",
         "chat",
         "phone",
         "video",
         "in_person",
         "other"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions using any of these channels."
    },
    "directions": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "inbound",
         "outbound",
         "mutual",
         "unknown"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions with any of these directions."
    },
    "statuses": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "planned",
         "confirmed",
         "completed",
         "canceled",
         "no_show"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions with any of these statuses."
    },
    "startsFrom": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions starting at or after this ISO 8601 timestamp."
    },
    "startsThrough": {
     "anyOf": [
      {
       "type": "string",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      },
      {
       "type": "null"
      }
     ],
     "description": "Include interactions starting at or before this ISO 8601 timestamp."
    },
    "query": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Case-insensitive text to search across interaction subject, summary, notes, and location."
    },
    "offset": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ],
     "description": "Zero-based number of matching records to skip. Uses 0 when not specified."
    },
    "limit": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      },
      {
       "type": "null"
      }
     ],
     "description": "Maximum number of records to return, from 1 to 50. Uses 20 when not specified."
    }
   },
   "required": [
    "personIds",
    "gigIds",
    "kinds",
    "channels",
    "directions",
    "statuses",
    "startsFrom",
    "startsThrough",
    "query",
    "offset",
    "limit"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "items",
      "page"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id",
         "subject",
         "kind",
         "channel",
         "direction",
         "status",
         "startsAt",
         "endsAt",
         "timezone",
         "location",
         "summary",
         "notes",
         "personIds",
         "gigId",
         "supersedesInteractionId",
         "originChangeId",
         "structuredData",
         "revision",
         "isDeleted",
         "createdAt",
         "updatedAt"
        ],
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "subject": {
          "type": "string",
          "minLength": 1
         },
         "kind": {
          "type": "string",
          "enum": [
           "message",
           "call",
           "meeting",
           "interview",
           "conversation",
           "other"
          ]
         },
         "channel": {
          "type": "string",
          "enum": [
           "email",
           "linkedin",
           "sms",
           "chat",
           "phone",
           "video",
           "in_person",
           "other"
          ]
         },
         "direction": {
          "type": "string",
          "enum": [
           "inbound",
           "outbound",
           "mutual",
           "unknown"
          ]
         },
         "status": {
          "type": "string",
          "enum": [
           "planned",
           "confirmed",
           "completed",
           "canceled",
           "no_show"
          ]
         },
         "startsAt": {
          "type": "string",
          "format": "date-time"
         },
         "endsAt": {
          "anyOf": [
           {
            "type": "string",
            "format": "date-time"
           },
           {
            "type": "null"
           }
          ]
         },
         "timezone": {
          "type": [
           "string",
           "null"
          ]
         },
         "location": {
          "type": [
           "string",
           "null"
          ]
         },
         "summary": {
          "type": [
           "string",
           "null"
          ]
         },
         "notes": {
          "type": [
           "string",
           "null"
          ]
         },
         "personIds": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "gigId": {
          "type": [
           "string",
           "null"
          ]
         },
         "supersedesInteractionId": {
          "type": [
           "string",
           "null"
          ]
         },
         "originChangeId": {
          "type": [
           "string",
           "null"
          ]
         },
         "structuredData": {
          "type": "object",
          "additionalProperties": true,
          "description": "Caller-defined structured payload; keys and JSON-compatible values are intentionally unconstrained."
         },
         "revision": {
          "type": "integer",
          "minimum": 1
         },
         "isDeleted": {
          "type": "boolean"
         },
         "createdAt": {
          "type": "string",
          "format": "date-time"
         },
         "updatedAt": {
          "type": "string",
          "format": "date-time"
         }
        }
       }
      },
      "page": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "offset",
        "limit",
        "returned",
        "total",
        "hasMore",
        "nextOffset"
       ],
       "properties": {
        "offset": {
         "type": "integer"
        },
        "limit": {
         "type": "integer"
        },
        "returned": {
         "type": "integer"
        },
        "total": {
         "type": "integer"
        },
        "hasMore": {
         "type": "boolean"
        },
        "nextOffset": {
         "type": [
          "integer",
          "null"
         ]
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "consistency_error"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
