{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/revert_change.schema.json",
 "title": "revert_change",
 "description": "Wire contract for supported agent-tool operation revert_change. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "changeId": {
     "type": "string",
     "minLength": 1,
     "description": "Exact change ID of the eligible create, update, delete, or restoration change to revert."
    }
   },
   "required": [
    "changeId"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "entity",
      "changeId",
      "revertedChangeId",
      "affected"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "entity": {
       "const": "change"
      },
      "changeId": {
       "type": "string",
       "minLength": 1
      },
      "revertedChangeId": {
       "type": "string",
       "minLength": 1
      },
      "affected": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "entity",
         "id"
        ],
        "properties": {
         "entity": {
          "type": "string",
          "enum": [
           "gig",
           "person",
           "gig-person",
           "task",
           "interaction",
           "interaction-participant"
          ]
         },
         "id": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
