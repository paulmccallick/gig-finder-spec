{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gigfinder.local/spec/contracts/operations/list_tasks.schema.json",
 "title": "list_tasks",
 "description": "Wire contract for supported agent-tool operation list_tasks. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "input",
  "result"
 ],
 "properties": {
  "input": {
   "type": "object",
   "properties": {
    "statuses": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "open",
         "in_progress",
         "completed",
         "canceled"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include tasks with any of these statuses."
    },
    "priorities": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "high",
         "medium",
         "low"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include tasks with any of these priorities."
    },
    "types": {
     "anyOf": [
      {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "networking_follow_up",
         "application",
         "interview_prep",
         "sourcing",
         "resume",
         "administrative",
         "learning",
         "other"
        ]
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Include tasks with any of these task types."
    },
    "relatedEntityType": {
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "gig",
        "person",
        "general"
       ]
      },
      {
       "type": "null"
      }
     ],
     "description": "Include tasks related to this kind of entity."
    },
    "relatedEntityId": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1
      },
      {
       "type": "null"
      }
     ],
     "description": "Include tasks related to this exact durable gig or person ID."
    },
    "overdueOnly": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "description": "When true, include only tasks whose due date is overdue."
    },
    "query": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Case-insensitive text to search across task title, related-entity label, and notes."
    },
    "offset": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ],
     "description": "Zero-based number of matching records to skip. Uses 0 when not specified."
    },
    "limit": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 50
      },
      {
       "type": "null"
      }
     ],
     "description": "Maximum number of records to return, from 1 to 50. Uses 20 when not specified."
    }
   },
   "required": [
    "statuses",
    "priorities",
    "types",
    "relatedEntityType",
    "relatedEntityId",
    "overdueOnly",
    "query",
    "offset",
    "limit"
   ],
   "additionalProperties": false
  },
  "result": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "items",
      "page"
     ],
     "properties": {
      "status": {
       "const": "ok"
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id",
         "title",
         "type",
         "status",
         "priority",
         "dueDate",
         "relatedEntity",
         "notes",
         "createdAt",
         "updatedAt",
         "completedAt"
        ],
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "title": {
          "type": "string",
          "minLength": 1
         },
         "type": {
          "type": "string",
          "enum": [
           "networking_follow_up",
           "application",
           "interview_prep",
           "sourcing",
           "resume",
           "administrative",
           "learning",
           "other"
          ]
         },
         "status": {
          "type": "string",
          "enum": [
           "open",
           "in_progress",
           "completed",
           "canceled"
          ]
         },
         "priority": {
          "type": "string",
          "enum": [
           "high",
           "medium",
           "low"
          ]
         },
         "dueDate": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           {
            "type": "null"
           }
          ]
         },
         "relatedEntity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "type",
           "id",
           "label"
          ],
          "properties": {
           "type": {
            "type": "string",
            "enum": [
             "gig",
             "person",
             "general"
            ]
           },
           "id": {
            "type": [
             "string",
             "null"
            ]
           },
           "label": {
            "type": "string",
            "minLength": 1
           }
          }
         },
         "notes": {
          "type": [
           "string",
           "null"
          ]
         },
         "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "completedAt": {
          "anyOf": [
           {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           {
            "type": "null"
           }
          ]
         }
        }
       }
      },
      "page": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "offset",
        "limit",
        "returned",
        "total",
        "hasMore",
        "nextOffset"
       ],
       "properties": {
        "offset": {
         "type": "integer"
        },
        "limit": {
         "type": "integer"
        },
        "returned": {
         "type": "integer"
        },
        "total": {
         "type": "integer"
        },
        "hasMore": {
         "type": "boolean"
        },
        "nextOffset": {
         "type": [
          "integer",
          "null"
         ]
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "id",
      "message"
     ],
     "properties": {
      "status": {
       "const": "consistency_error"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "error",
      "message"
     ],
     "properties": {
      "status": {
       "const": "error"
      },
      "error": {
       "type": "string",
       "enum": [
        "duplicate_change",
        "duplicate",
        "not_found",
        "consistency_error",
        "not_revertible",
        "revision_conflict",
        "validation_failed",
        "unsupported",
        "tool_failed"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    }
   ]
  }
 }
}
