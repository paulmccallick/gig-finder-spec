{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigfinder.local/spec/contracts/operations/list_tasks.schema.json",
  "title": "list_tasks",
  "description": "Wire contract for supported agent-tool operation list_tasks. Input is mechanically derived from the strict application schema; workflow documents define product meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "result"
  ],
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "statuses": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "open",
                  "in_progress",
                  "completed",
                  "canceled"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Include tasks with any of these statuses."
        },
        "priorities": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Include tasks with any of these priorities."
        },
        "types": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "networking_follow_up",
                  "application",
                  "interview_prep",
                  "sourcing",
                  "resume",
                  "administrative",
                  "learning",
                  "other"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Include tasks with any of these task types."
        },
        "relatedEntityType": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gig",
                "person",
                "general"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Include tasks related to this kind of entity."
        },
        "relatedEntityId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Include tasks related to this exact durable gig or person ID."
        },
        "overdueOnly": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "When true, include only tasks whose due date is overdue."
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Case-insensitive text to search across task title, related-entity label, and notes."
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Zero-based number of matching records to skip. Uses 0 when not specified."
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum number of records to return, from 1 to 50. Uses 20 when not specified."
        }
      },
      "required": [
        "statuses",
        "priorities",
        "types",
        "relatedEntityType",
        "relatedEntityId",
        "overdueOnly",
        "query",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items",
            "page"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "page": {
              "type": "object",
              "required": [
                "offset",
                "limit",
                "total",
                "nextOffset"
              ],
              "properties": {
                "offset": {
                  "type": "integer"
                },
                "limit": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                },
                "nextOffset": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "message"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "enum": [
                "duplicate_change",
                "duplicate",
                "not_found",
                "consistency_error",
                "not_revertible",
                "revision_conflict",
                "validation_failed",
                "unsupported",
                "tool_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
